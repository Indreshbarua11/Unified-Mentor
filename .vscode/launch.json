{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run analysis",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\run_analysis.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}\\app.py"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
